generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username             String?   @unique
  name                 String?
  email                String?   @unique
  provider             AuthProvider
  password             String?
  nameLocked           Boolean   @default(false)
  publicProfile        Boolean   @default(false)
  processingRestricted Boolean   @default(false)
  deletedAt            DateTime?
  rating               Int       @default(1200)
  gamesAsWhite         Game[]    @relation("GamesAsWhite")
  gamesAsBlack         Game[]    @relation("GamesAsBlack")
  consents             Consent[]
  privacyRequests      PrivacyRequest[]
  disclosures          RecipientDisclosure[]
  createdAt            DateTime  @default(now())
  lastLogin            DateTime?

  @@index([rating])
}

model Game {
  id            String     @id @default(uuid())
  whitePlayerId String
  blackPlayerId String
  whitePlayer   User       @relation("GamesAsWhite", fields: [whitePlayerId], references: [id])
  blackPlayer   User       @relation("GamesAsBlack", fields: [blackPlayerId], references: [id])
  status        GameStatus
  result        GameResult?
  timeControl   TimeControl
  startingFen   String     @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1") // default value for the startingFen
  currentFen    String?
  startAt       DateTime   @default(now())
  endAt         DateTime?
  moves         Move[]
  opening       String?
  event         String?

  @@index([status, result])
}

model Move {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  moveNumber  Int
  from        String
  to          String
  comments    String?
  before      String
  after       String
  timeTaken   Int?     @default(0)
  createdAt   DateTime @default(now())
  san         String?   

  @@index([gameId])
}

model Consent {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String
  source        String
  capturedAt    DateTime       @default(now())
  withdrawnAt   DateTime?

  @@index([userId, purpose])
}

model PrivacyRequest {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  kind        PrivacyRequestKind
  status      PrivacyRequestStatus
  reason      String?
  createdAt   DateTime             @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}

model RecipientDisclosure {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  recipient   String
  dataAsset   String
  disclosedAt DateTime  @default(now())
  notifiedOf  String?
  notifiedAt  DateTime?

  @@index([userId])
}

enum ConsentPurpose {
  PUBLIC_PROFILE
}

enum PrivacyRequestKind {
  ACCESS
  EXPORT
  RECTIFY
  ERASE
  RESTRICT
  OBJECT
}

enum PrivacyRequestStatus {
  COMPLETED
  REJECTED
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIME_UP
  PLAYER_EXIT
}

enum GameResult {
  WHITE_WINS
  BLACK_WINS
  DRAW
}

enum TimeControl {
  CLASSICAL
  RAPID
  BLITZ
  BULLET
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
  GUEST
}